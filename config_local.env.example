SECRET_KEY=replace-with-a-random-local-secret

DB_HOST=127.0.0.1
DB_DATABASE=pfotenregister
DB_PORT=3306
DB_USER=pfotenregister
DB_PASSWORD=pfotenregister-local

# Recommended for local development. The directory is relative to this folder.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=var/uploads

# Alternative for Google Cloud Storage:
# STORAGE_BACKEND=gcs
# GCS_BUCKET_NAME=replace-with-your-development-bucket
# Optional when Application Default Credentials are configured for GCS.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GCP_PROJECT=replace-with-your-gcp-project

# Optional mail configuration.
# MAIL_KEY=
# REPLY_TO=
